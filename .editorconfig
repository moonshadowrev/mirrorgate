root = true

[*]
charset = utf-8
end_of_line = lf
insert_final_newline = true
trim_trailing_whitespace = true
indent_style = space
indent_size = 4

[*.php]
indent_size = 4

[bin/*]
indent_size = 4

[*.{yml,yaml,json,md,html,neon}]
indent_size = 2

[*.md]
trim_trailing_whitespace = false

[{phpstan.neon.dist,phpunit.xml.dist}]
indent_size = 4
