# MirrorGate configuration reference
# =================================
#
# Copy this file to `.env` (or to `.env.php`, see below) and edit it. Every variable
# is listed here with its default. Optional variables are commented out: remove the
# leading "# " only for the values you want to change. Only ORIGIN_URL and MIRROR_URL
# are required.
#
# Where the file lives
#   Standard layout : <project>/.env, one directory ABOVE public/. Point the web server
#                     docroot at public/.
#   Docroot cannot move (shared hosting without docroot control): use the self-protecting
#                     `.env.php` form. Create a file named `.env.php` whose FIRST line is
#                     exactly:
#                         <?php http_response_code(404); exit; ?>
#                     followed by the KEY=VALUE lines below. Requested over HTTP it answers 404
#                     and prints nothing; the parser skips that first line. In this layout also
#                     set STORAGE_DIR to a directory OUTSIDE the docroot, otherwise MirrorGate
#                     refuses to boot (see ALLOW_SECRETS_IN_DOCROOT).
#   Several instances: one (sub)domain = one docroot = one env file = one STORAGE_DIR.
#                     Point an instance at a specific file with the MIRRORGATE_ENV constant in
#                     its index.php stub, or with the MIRRORGATE_ENV process environment variable.
#
# File syntax
#   KEY=VALUE per line, optional leading "export ". "#" starts a comment at the start of a
#   line or after whitespace (unquoted values). Double quotes support \n \r \t \" \\ \$
#   escapes, single quotes are literal. No variable expansion. Keys match ^[A-Z][A-Z0-9_]*$.
#   Booleans : true|false|1|0|yes|no|on|off.
#   Lists    : comma separated, whitespace trimmed, empty items dropped.
#   Durations: integer seconds (names ending in _MS are milliseconds).
#   Sizes    : integer bytes, or with suffix K, M, G (powers of 1024), for example 10M.
#   A process environment variable of the same name overrides the value from this file.
#
# Never commit the real env file. Secrets below are intentionally empty.
# Run `php bin/mirrorgate config:dump` to see the effective configuration (secrets masked)
# and `php bin/mirrorgate check` to validate the setup.


# ------------------------------------------------------------------------------
# 3.2 Origin and mirror identity (required)
# ------------------------------------------------------------------------------

# [REQUIRED] The remote site to mirror. Scheme://host[:port] only: no path, query or
# userinfo. https is required unless ORIGIN_ALLOW_HTTP=true.
ORIGIN_URL=https://overlord.team

# [REQUIRED] Public URL of this mirror. Same format. Its host must differ from the origin
# host and must not be a subdomain of the origin host (or the reverse).
MIRROR_URL=https://overload.ir

# Extra inbound hostnames that are accepted and treated as this mirror (hostnames only).
# Default: empty.
# MIRROR_ALIASES=www.overload.ir

# Allow a plain http:// origin. Default: false.
# ORIGIN_ALLOW_HTTP=false

# Disable the private/loopback/link-local IP block (SSRF guard) for the origin and
# extra origins. Only for tests or an origin on a private network. Default: false.
# ALLOW_PRIVATE_ORIGIN=false

# Ports MirrorGate may connect to upstream. The origin port is added automatically.
# Default: 80,443.
# ORIGIN_PORTS_ALLOW=80,443

# Pin the origin DNS name to this IP (CURLOPT_RESOLVE). It still passes the SSRF guard.
# Also the fallback when DNS fails and nothing is cached. Ignored when OUTBOUND_PROXY is
# set. Default: empty.
# ORIGIN_RESOLVE_IP=

# Send ALL upstream traffic through a proxy: http://, https://, socks5:// or socks5h://
# (prefer socks5h:// so DNS is resolved by the proxy). Use this when the host filters
# outbound traffic. Credentials are allowed here only and are redacted everywhere.
# When set, the proxy is the SSRF boundary: only the hostname and port allow lists apply.
# Default: empty.
# OUTBOUND_PROXY=

# Optional PEM CA bundle (CURLOPT_CAINFO) for hosts with an outdated system trust store.
# The file must exist. Download a current bundle (for example from curl.se/ca/cacert.pem),
# verify its checksum, and keep it outside the web root.
# Default: empty.
# CA_BUNDLE=

# Rewrite pairs "originhost=mirrorhost,..." for sibling instances (other subdomains of the
# origin that are mirrored by other MirrorGate instances). The mapping must be reciprocal
# across siblings, see docs/multi-instance.md. Default: empty.
# HOST_MAP=api.overlord.team=api.overload.ir

# Additional origin hosts this instance may proxy in prefix mode (origin host or its
# subdomains, max 32). REJECTED unless PREFIX_MODE_ACK_SHARED_ORIGIN=true. Default: empty.
# EXTRA_ORIGINS=

# off | prefix. "prefix" serves extra origin hosts under SUBDOMAIN_PREFIX/<host>/ through
# one mirror host. It merges those hosts into ONE browser origin (shared cookies, storage
# and script access) and therefore requires PREFIX_MODE_ACK_SHARED_ORIGIN=true. The safer
# default for multi-host origins is one instance per subdomain plus HOST_MAP. Default: off.
# SUBDOMAIN_MODE=off

# URL prefix used by prefix mode. ^/[A-Za-z0-9_./-]{1,64}$, no trailing slash, no "..".
# Default: /__mg/s
# SUBDOMAIN_PREFIX=/__mg/s

# Explicit acknowledgement that prefix mode / EXTRA_ORIGINS make all listed hosts share the
# mirror's cookies, storage and script access. Default: false.
# PREFIX_MODE_ACK_SHARED_ORIGIN=false

# Seconds a validated origin DNS answer is cached in STORAGE_DIR/dns (1..3600). Default: 60.
# DNS_TTL=60

# Seconds an expired cached DNS answer may still be reused when the resolver fails
# (>= DNS_TTL, <= 86400). Default: 3600.
# DNS_STALE_TTL=3600

# ws:// or wss://host[:port] served by the optional daemon. When set, ws(s):// literals that
# point at the origin are rewritten to this base. When empty they are left untouched,
# because PHP cannot serve WebSockets. Default: empty.
# WS_PUBLIC_URL=


# ------------------------------------------------------------------------------
# 3.1 Application
# ------------------------------------------------------------------------------

# production | development. Default: production.
# APP_ENV=production

# When true the log level is forced to debug. It NEVER changes HTTP output: stack traces
# are never sent to clients. Default: false.
# APP_DEBUG=false

# ^[a-z0-9_-]{4,32}$. Namespaces cache, locks and rate limits. MUST differ per instance when
# instances share a STORAGE_DIR (they should not). Default: first 12 hex of
# sha256(origin host|mirror host).
# APP_INSTANCE_ID=

# PHP timezone identifier. Default: UTC.
# APP_TIMEZONE=UTC

# Runtime data (cache, logs, locks, rate limits, breaker state, DNS cache). Absolute path or
# relative to the directory of the env file. Must NOT be inside the web-served docroot.
# Default: <directory of the env file>/var
# STORAGE_DIR=

# debug | info | warning | error. Default: warning.
# LOG_LEVEL=warning

# Log file path. When unset the name gets an unguessable suffix
# (mirrorgate-<12 hex>.log) so it cannot be fetched by guessing. An explicit value is used
# verbatim. Default: STORAGE_DIR/logs/mirrorgate-<suffix>.log
# LOG_FILE=

# Log rotation size (>= 64K). Default: 5M.
# LOG_MAX_BYTES=5M

# How request paths appear in the access log: segments (first two segments only, for example
# /reset/*), hash (12 hex of a keyed hash) or full. Query strings and Referer are never
# logged. Default: segments.
# LOG_PATH_MODE=segments

# Allow the env file or STORAGE_DIR to sit under the web docroot. When false MirrorGate
# refuses to boot in that situation (the self-protecting .env.php form is exempt).
# Default: false.
# ALLOW_SECRETS_IN_DOCROOT=false

# File mode for files MirrorGate creates (octal). Use 0644 with mod_php on non-isolated
# hosts where PHP runs as "nobody"; keep 0640 or 0600 for PHP-FPM or suPHP with one user per
# account. Default: 0640.
# STORAGE_FILE_MODE=0640

# Directory mode (octal). Use 0755 for the mod_php case above. Default: 0750.
# STORAGE_DIR_MODE=0750

# Language of the built-in error pages: en | fa. Default: en.
# ERROR_PAGE_LANG=en

# Directory with custom error page templates. Default: empty (built-in templates).
# ERROR_PAGE_DIR=

# Which origin errors are replaced by the friendly page: gateway (origin 502/503/504),
# all (every origin 5xx) or off (pass origin bodies). Default: gateway.
# ERROR_PAGE_UPSTREAM=gateway

# Emit X-MirrorGate-Cache, Age and Cache-Status response headers. Default: true.
# EXPOSE_CACHE_HEADERS=true

# Add "Via: 1.1 mirrorgate" in both directions. Default: true.
# ADD_VIA=true


# ------------------------------------------------------------------------------
# 3.3 Upstream, limits, resilience
# ------------------------------------------------------------------------------

# Seconds to connect to the origin (1..60). Default: 5.
# ORIGIN_CONNECT_TIMEOUT=5

# Total seconds per origin request (1..300, >= connect timeout). Default: 30.
# ORIGIN_TIMEOUT=30

# Abort a transfer slower than ORIGIN_LOW_SPEED_LIMIT for this many seconds. 0 disables,
# otherwise 5..300. Default: 20.
# ORIGIN_LOW_SPEED_TIME=20

# Bytes per second for the low-speed check (>= 1). Default: 256.
# ORIGIN_LOW_SPEED_LIMIT=256

# Retries for idempotent requests only (GET, HEAD, OPTIONS), 0..3. Default: 1.
# ORIGIN_RETRIES=1

# Retry back-off base in milliseconds (10..5000). Default: 100.
# ORIGIN_RETRY_BASE_MS=100

# Retry back-off cap in milliseconds (>= base, <= 10000). Default: 1000.
# ORIGIN_RETRY_CAP_MS=1000

# 1.1 | 2. HTTP/2 is used only if libcurl supports it, otherwise 1.1 silently. Default: 1.1.
# ORIGIN_HTTP_VERSION=1.1

# Maximum accepted request body (0..2G). Also capped by PHP post_max_size. Default: 10M.
# MAX_REQUEST_BODY_BYTES=10M

# Maximum request URL length (256..65536). Default: 8192.
# MAX_URL_LENGTH=8192

# Maximum number of request headers (10..500). Default: 100.
# MAX_HEADER_COUNT=100

# Maximum size of one request header line (1K..64K). Default: 8192.
# MAX_HEADER_BYTES=8192

# Maximum bytes relayed in one passthrough stream (0 = unlimited). Bounded by default to
# protect shared bandwidth and worker time. Default: 100M.
# MAX_STREAM_BYTES=100M

# Allowed request methods, subset of GET,HEAD,POST,PUT,PATCH,DELETE,OPTIONS. TRACE and
# CONNECT are rejected. Default: GET,HEAD,POST,PUT,PATCH,DELETE,OPTIONS.
# ALLOWED_METHODS=GET,HEAD,POST,PUT,PATCH,DELETE,OPTIONS

# Circuit breaker on origin failures. Default: true.
# BREAKER_ENABLED=true

# Failures within BREAKER_WINDOW that open the breaker (1..100). Default: 5.
# BREAKER_THRESHOLD=5

# Failure counting window in seconds (5..600). Default: 30.
# BREAKER_WINDOW=30

# Initial open duration in seconds (5..3600). Default: 30.
# BREAKER_COOLDOWN=30

# Back-off cap for the open duration (>= BREAKER_COOLDOWN). Default: 300.
# BREAKER_MAX_COOLDOWN=300

# Forward the client Cookie header to the origin (mirror-reserved cookies are always
# removed; never sent on cache-fill requests). The mirror operator can read every forwarded
# credential: see the security documentation. Default: true.
# FORWARD_COOKIES=true

# Forward the Authorization header (never sent on cache-fill requests). Same warning as
# FORWARD_COOKIES. Default: true.
# FORWARD_AUTHORIZATION=true

# Send X-Forwarded-For with the resolved client IP on requests that are not cache fills.
# Cache fills are shared by all visitors, so they never carry a client address (an origin
# that varies its answer by client IP is therefore not cached per visitor). Default: true.
# FORWARD_CLIENT_IP=true

# Extra client request headers to drop before they reach the origin, lowercase. An entry ending
# in * is a prefix. Added to the built-in list of spoofable client-address, scheme and identity
# headers (X-Real-IP, X-Remote-User, X-Auth-Request-*, ...). Header names containing "_" are
# always dropped. Default: empty.
# REQUEST_HEADER_STRIP=


# ------------------------------------------------------------------------------
# 3.4 Rewriting
# ------------------------------------------------------------------------------

# Master switch for all content rewriting. Default: true.
# REWRITE_ENABLED=true

# Rewrite HTML (attributes, srcset, meta refresh, inline data blocks). Default: true.
# REWRITE_HTML=true

# Rewrite CSS (url(), @import). Default: true.
# REWRITE_CSS=true

# Rewrite JSON (+json, manifests, __NEXT_DATA__). Default: true.
# REWRITE_JSON=true

# Rewrite XML (RSS, Atom, sitemaps). Default: true.
# REWRITE_XML=true

# Replace full host literals in JavaScript. Never tokenizes. Needed for hard-coded API hosts
# in bundles. Default: false.
# REWRITE_JS=false

# Rewrite text/x-component (React Server Components). Unsafe because of length-prefixed
# rows. Default: false.
# REWRITE_RSC=false

# Also replace the bare host in HTML text nodes (default: attributes and data blocks only).
# Default: false.
# REWRITE_VISIBLE_TEXT=false

# Rewrite the mirror host to the origin host in form-urlencoded and JSON request bodies
# (max 1M). Default: false.
# REWRITE_REQUEST_BODY=false

# Remove Subresource Integrity hashes only from tags that point at a rewritten URL.
# Third-party SRI is never touched. Default: true.
# REWRITE_STRIP_INTEGRITY=true

# Bodies larger than this are streamed unmodified; also the decoded-size limit
# (64K..64M). Default: 8M.
# REWRITE_MAX_BYTES=8M

# Size limit for sitemaps and robots.txt rewriting. Rewriting needs several times this much
# memory; bodies that do not fit in memory_limit are passed through unrewritten and not cached.
# Default: 16M.
# REWRITE_SITEMAP_MAX_BYTES=16M

# mirror | canonical-origin | noindex. How canonical links and indexing hints are treated.
# Default: mirror.
# SEO_MODE=mirror

# rewrite | strip | passthrough. Content-Security-Policy handling. Default: rewrite.
# CSP_MODE=rewrite

# passthrough | rewrite | block. Service worker scripts. Default: passthrough.
# SERVICE_WORKER_MODE=passthrough

# strip (remove origin HSTS) | own (send HSTS_VALUE). Default: strip.
# HSTS_MODE=strip

# HSTS value used when HSTS_MODE=own and the mirror is https. "preload" is never added for
# you. Default: max-age=31536000
# HSTS_VALUE=max-age=31536000

# Remove the Alt-Svc header. Default: true.
# STRIP_ALT_SVC=true

# drop (host-only cookies) | rewrite (map Domain to the mirror host). "rewrite" is the
# documented choice for sibling sets, at the cost described in docs/multi-instance.md.
# Default: drop.
# COOKIE_DOMAIN_MODE=drop

# Add Secure to cookies when the mirror is https. Default: true.
# COOKIE_FORCE_SECURE=true

# pass (forward redirects to unrelated hosts unchanged) | block (replace with a 502 page).
# Default: pass.
# REDIRECT_EXTERNAL=pass

# gzip buffered text responses when the client accepts it and ext-zlib exists.
# Default: true.
# RECOMPRESS=true

# Extra response header names to remove, lowercase. An entry ending in * is a prefix.
# Applied together with the built-in deny list. Default: empty.
# RESPONSE_HEADER_STRIP=


# ------------------------------------------------------------------------------
# 3.5 Cache
# ------------------------------------------------------------------------------

# Master switch for the response cache. Default: true.
# CACHE_ENABLED=true

# Cache directory, writable, per instance. Default: STORAGE_DIR/cache
# CACHE_DIR=

# Total cache size (>= 1M). Default: 256M.
# CACHE_MAX_BYTES=256M

# Largest single cached object (<= CACHE_MAX_BYTES). Default: 5M.
# CACHE_MAX_OBJECT_BYTES=5M

# Hard cap on cache files (protects hosting inode quotas), 100..1000000. When reached new
# entries are refused after one bounded GC pass. Default: 20000.
# CACHE_MAX_ENTRIES=20000

# Freshness in seconds when the origin gives none. Default: 300.
# CACHE_DEFAULT_TTL=300

# Lower clamp for freshness. Default: 0.
# CACHE_MIN_TTL=0

# Upper clamp for freshness (>= CACHE_MIN_TTL). Default: 86400.
# CACHE_MAX_TTL=86400

# TTL for 404/410 responses. Default: 60.
# CACHE_NEGATIVE_TTL=60

# Stale-while-revalidate window when the origin gives none. Default: 60.
# CACHE_SWR_SECONDS=60

# Serve stale content for this long when the origin fails (7 days). Default: 604800.
# CACHE_STALE_IF_ERROR_SECONDS=604800

# Extensions (lowercase, no dot) that stay cacheable for cookie-bearing requests in
# static-only mode. json, xml, txt, map and webmanifest are deliberately not listed because
# they are often personalized. Default shown.
# CACHE_STATIC_EXTENSIONS=js,css,mjs,png,jpg,jpeg,gif,webp,avif,svg,ico,woff,woff2,ttf,otf,eot,mp4,webm,mp3

# "glob=ttl" pairs, first match wins, ttl=-1 bypasses the cache, * and ? wildcards anchored
# on the path. Example: /assets/*=86400,/api/*=-1. Default: empty.
# CACHE_RULES=

# bypass (any Cookie header bypasses the cache) | static-only (cookie-bearing requests are
# cached only for static extensions). Default: static-only.
# CACHE_COOKIE_MODE=static-only

# Honor client Cache-Control: no-cache / max-age=0. Default: false.
# CACHE_HONOR_CLIENT_NOCACHE=false

# Serve stale content on origin errors even for must-revalidate responses (a documented
# deviation from RFC 9111 4.2.4). Default: true.
# CACHE_IGNORE_MUST_REVALIDATE_ON_ERROR=true

# Milliseconds a request waits for a concurrent fill of the same object (0..30000). Waiters
# hold a PHP worker, so keep it small on shared pools. Default: 1500.
# CACHE_COALESCE_WAIT_MS=1500

# Percent chance (0..100) per request that garbage collection runs. Default: 1.
# CACHE_GC_PROBABILITY=1

# Minimum seconds between garbage collection runs. Default: 300.
# CACHE_GC_INTERVAL=300

# flock | mkdir. Use mkdir on NFS hosts. Default: flock.
# CACHE_LOCK_MODE=flock

# Query parameters removed from the cache KEY and from the query sent to the origin on cache
# fills, so a stored response is a pure function of its key.
# Example: utm_source,utm_medium,fbclid. Default: empty.
# CACHE_IGNORE_QUERY_PARAMS=

# Extra request headers always included in the cache key. Listing a header here is the only
# way Accept-Language, User-Agent or Accept reach the origin on cache fills. Example:
# accept-language. Default: empty.
# CACHE_VARY_EXTRA=
#
# An origin response whose Vary names a header that cache fills never send (for example
# Accept, Accept-Language or User-Agent) is not stored, unless the header is listed here.

# Request headers that make a request bypass the cache (they carry credentials the anonymous
# cache fill would drop). Default: x-api-key,x-auth-token,x-access-token,proxy-authorization,
# x-csrf-token,x-xsrf-token. Requests with a Service-Worker header or a cross-site Origin
# header also bypass the cache.
# CACHE_BYPASS_HEADERS=

# Distinct query strings stored per path; beyond this the oldest variant of that path is
# evicted, so cache-busting URLs cannot push out other pages. Default: 20.
# CACHE_MAX_QUERY_VARIANTS=20

# Status codes that may be cached, subset of 200,203,204,300,301,308,404,405,410,414,501.
# Default: 200,301,308,404,410.
# CACHE_STATUSES=200,301,308,404,410


# ------------------------------------------------------------------------------
# 3.6 Security, admin, rate limits, streaming
# ------------------------------------------------------------------------------

# CIDRs of reverse proxies / CDNs whose forwarded client IP header is trusted. Empty means
# forwarded headers are never trusted. Entries "@file:<path>" (one CIDR per line, "#" comments)
# are read at boot; use it for the ranges your CDN publishes. Default: empty.
# TRUSTED_PROXIES=

# x-forwarded-for | cf-connecting-ip | x-real-ip. Default: x-forwarded-for.
# TRUSTED_PROXY_HEADER=x-forwarded-for

# Glob patterns answered with a local 404 and never sent to the origin. Default: empty.
# BLOCKED_PATHS=

# Glob patterns for login/OAuth/session endpoints that must never pass through the mirror.
# Recommended whenever the origin has authenticated areas. Merged into BLOCKED_PATHS.
# Example: /login*,/oauth/*,/api/auth/*,/signin*,/account/*. Default: empty.
# AUTH_PASSTHROUGH_BLOCK=

# Add security headers to MirrorGate-generated responses (error pages, admin). Default: true.
# SECURITY_HEADERS=true

# Enable the admin endpoints under ADMIN_PATH_PREFIX. When false the prefix answers 404 for
# everyone. Default: false.
# ADMIN_ENABLED=false

# Admin bearer secret, required when the admin is enabled. At least 32 characters, generated
# randomly (for example `php -r "echo bin2hex(random_bytes(32)), PHP_EOL;"`). Values
# containing "change-me", "example" or "token", or one repeated character, are rejected.
# Default: empty.
# ADMIN_TOKEN=

# Admin URL prefix, ^/[A-Za-z0-9_-]{3,32}$. Reserved: never proxied or cached.
# Default: /__mirrorgate
# ADMIN_PATH_PREFIX=/__mirrorgate

# CIDRs allowed to reach the admin. Empty means any IP. Default: empty.
# ADMIN_IP_ALLOW=

# Failed admin authentications are counted per client (/64 for IPv6). Throttling never changes the
# answer (always the generic 404) and never locks out a valid token. Default: 5.
# ADMIN_FAIL_LIMIT=5

# Window in seconds for the failure limits. Default: 900.
# ADMIN_FAIL_WINDOW=900

# Kept for compatibility; a global failure count no longer locks anything. Default: 50.
# ADMIN_GLOBAL_FAIL_LIMIT=50

# Kept for compatibility; valid tokens are never throttled. Default: 60.
# ADMIN_REQUESTS_PER_MINUTE=60

# Allow the admin while MIRROR_URL is http://. The token travels in a header, so this is
# discouraged (it is also needed behind a CDN in "Flexible" TLS mode, which is NOT
# recommended). Default: false.
# Without it the admin answers 404 to any request that did not arrive over TLS (directly, or
# via X-Forwarded-Proto from a TRUSTED_PROXIES address). Default: false.
# ADMIN_ALLOW_HTTP=false

# Per-client request rate limiting. Default: true.
# RATE_LIMIT_ENABLED=true

# Requests per client IP per window (1..100000). Default: 120.
# RATE_LIMIT_REQUESTS=120

# Rate limit window in seconds (1..3600). Default: 60.
# RATE_LIMIT_WINDOW=60

# auto (APCu if usable, else file) | apcu | file. Default: auto.
# RATE_LIMIT_DRIVER=auto

# In-flight requests per client IP (IPv6 per /64). 0 = off. Defaults assume a PHP worker pool
# of 5 to 20 workers shared by every instance of the hosting account. Default: 4.
# RATE_LIMIT_MAX_CONCURRENT=4

# Cap on origin fetches by this instance per minute. 0 = off. Default: 600.
# RATE_LIMIT_ORIGIN_FETCHES_PER_MINUTE=600

# CIDRs that skip all limits. Default: empty.
# RATE_LIMIT_EXEMPT_IPS=

# Secret salt for keyed hashes. Leave empty: 32 random bytes are generated once and stored
# at STORAGE_DIR/run/salt. Default: empty.
# RATE_LIMIT_SALT=

# Cap on requests doing origin I/O at the same time; excess answers 503 with Retry-After: 1.
# 0 = off. Account-wide only when siblings share CONCURRENCY_SHARED_DIR. Default: 8.
# GLOBAL_MAX_CONCURRENT=8

# Absolute, writable directory OUTSIDE the docroot. Instances pointing at the same directory
# share one slot pool for GLOBAL_MAX_CONCURRENT. Default: empty (per instance).
# CONCURRENCY_SHARED_DIR=

# Stream text/event-stream responses (Server-Sent Events). Default: true.
# SSE_ENABLED=true

# Maximum seconds one SSE response stays open (10..3600); EventSource reconnects by itself.
# Further clamped by the PHP runtime limits. Default: 60.
# SSE_MAX_DURATION=60

# Seconds between ": ping" heartbeat comments at event boundaries (0 disables, else 5..120).
# Default: 20.
# SSE_HEARTBEAT=20

# Concurrent streaming responses per instance. Default: 3.
# MAX_CONCURRENT_STREAMS=3


# ------------------------------------------------------------------------------
# 3.7 Daemon (read by bin/mirrorgate-daemon only; harmless for the web app)
# ------------------------------------------------------------------------------
# The daemon needs a VPS or any host where you can run a long-lived CLI process. Shared
# hosting php-fpm cannot hold WebSocket, gRPC, TCP or UDP sockets.

# Listeners, one per variable: DAEMON_LISTEN_1 ... DAEMON_LISTEN_32 (numbers need not be
# contiguous). Grammar:
#   <kind>://<bind-host>:<bind-port>-><target-scheme>://<target-host>:<target-port>[?k=v&k=v]
#   kind ws   -> target ws | wss        (WebSocket upgrade, then opaque pipe)
#   kind tcp  -> target tcp | tls       (raw TCP)
#   kind udp  -> target udp             (datagram forwarder with sessions)
#   kind grpc -> target h2c | tls       (HTTP/2 pipe, h2c unless tls_cert is set)
# Options: idle, max_conn, max_per_ip, tls_cert, tls_key, alpn, sni, host, origin_allow,
# allow_no_origin, proxy_protocol. Bind host must be an IP literal. Default: all empty.
# DAEMON_LISTEN_1=ws://127.0.0.1:9001->wss://overlord.team:443
# DAEMON_LISTEN_2=tcp://127.0.0.1:9002->tls://overlord.team:443
# DAEMON_LISTEN_3=udp://127.0.0.1:9003->udp://overlord.team:53
# DAEMON_LISTEN_4=grpc://127.0.0.1:9004->tls://overlord.team:443

# A bind host other than 127.0.0.1 / ::1 requires this. Prefer binding to loopback behind a
# reverse proxy. Default: false.
# DAEMON_ALLOW_PUBLIC_BIND=false

# Maximum simultaneous connections (1..1000, limited by the select() descriptor limit).
# Default: 800.
# DAEMON_MAX_CONNECTIONS=800

# Maximum simultaneous connections per client IP. Default: 50.
# DAEMON_MAX_CONN_PER_IP=50

# Idle timeout per connection in seconds (default for every listener). Default: 120.
# DAEMON_IDLE_TIMEOUT=120

# WebSocket request headers must complete within this many seconds. Default: 10.
# DAEMON_HANDSHAKE_TIMEOUT=10

# WebSocket handshake size cap. Default: 16K.
# DAEMON_MAX_HEADER_BYTES=16K

# Per-direction write buffer watermark (backpressure). Unless set, it is derived from
# DAEMON_MEMORY_LIMIT and DAEMON_MAX_CONNECTIONS so that all sessions together stay inside
# 60 percent of the memory limit (at most 256K). `bin/mirrorgate check` warns when
# DAEMON_MAX_CONNECTIONS x 2 x (value + 64K) exceeds the memory limit.
# DAEMON_BUFFER_HIGH_WATER=256K

# Idle expiry of a UDP session in seconds. Default: 60.
# DAEMON_UDP_SESSION_TTL=60

# Maximum UDP sessions. Default: 1024.
# DAEMON_UDP_MAX_SESSIONS=1024

# Largest forwarded UDP datagram in bytes. Default: 65507.
# DAEMON_UDP_MAX_DATAGRAM=65507

# Datagrams per client per second. Default: 200.
# DAEMON_UDP_RATE_PER_SEC=200

# Maximum WebSocket connection lifetime in seconds. 0 = unlimited. Default: 0.
# DAEMON_WS_MAX_LIFETIME=0

# Exact browser Origin values (scheme://host[:port]) accepted on WebSocket handshakes.
# Default: the origin of MIRROR_URL plus the origin of every MIRROR_ALIASES host.
# DAEMON_WS_ORIGIN_ALLOW=

# Accept WebSocket handshakes without an Origin header (non-browser clients). Per-listener
# override: allow_no_origin. Default: false.
# DAEMON_WS_ALLOW_NO_ORIGIN=false

# CIDRs allowed to use udp listeners. REQUIRED (non-empty) for any udp listener whose bind
# host is not loopback, because UDP source addresses are spoofable. Ranges wider than /8 (IPv4)
# or /32 (IPv6), including 0.0.0.0/0, are rejected. Default: empty.
# DAEMON_UDP_CLIENT_ALLOW=

# Per client address (not per source port), reply bytes may not exceed this ratio times
# request bytes plus a one-time 4 KiB allowance. Default: 2.
# DAEMON_UDP_MAX_AMPLIFICATION=2

# CIDRs allowed to use tcp and grpc listeners. Empty means any address. For grpc listeners and
# tcp listeners with a tls:// target the origin connection is opened only after the client has
# sent its first bytes. Default: empty.
# DAEMON_TCP_CLIENT_ALLOW=

# Hosts the daemon may connect to. IP literals only if listed. Default: the origin host plus
# EXTRA_ORIGINS.
# DAEMON_TARGET_ALLOWLIST=

# Allow private/loopback targets. Default: the value of ALLOW_PRIVATE_ORIGIN.
# DAEMON_ALLOW_PRIVATE_TARGETS=false

# Target DNS cache in seconds. Default: 60.
# DAEMON_TARGET_DNS_TTL=60

# PID file. Default: STORAGE_DIR/run/daemon.pid
# DAEMON_PID_FILE=

# Daemon log file. Default: STORAGE_DIR/logs/daemon.log
# DAEMON_LOG_FILE=

# Create this file to stop the daemon (polled each tick, works without pcntl).
# Default: STORAGE_DIR/run/daemon.stop
# DAEMON_STOP_FILE=

# PHP memory_limit for the daemon process. Default: 256M.
# DAEMON_MEMORY_LIMIT=256M
