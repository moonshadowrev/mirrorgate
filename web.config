<?xml version="1.0" encoding="UTF-8"?>
<!--
  MirrorGate: IIS equivalent of the root .htaccess shim rules (docroot = project root).
  Requires the URL Rewrite module and PHP via FastCGI. When the site root can point at public/,
  do that instead and keep the env file and var/ outside it.

  Every request is routed to index.php; nothing in the project is served directly except the
  index.php shim and real non-PHP files under /.well-known/. Dotfile paths answer 403.
-->
<configuration>
  <system.webServer>
    <defaultDocument enabled="true">
      <files>
        <clear />
        <add value="index.php" />
      </files>
    </defaultDocument>
    <directoryBrowse enabled="false" />
    <httpErrors existingResponse="PassThrough" />
    <rewrite>
      <rules>
        <rule name="MirrorGate deny dotfiles" stopProcessing="true">
          <match url="(^|/)\.(?!well-known(/|$))" ignoreCase="true" />
          <action type="CustomResponse" statusCode="403" statusReason="Forbidden" statusDescription="Forbidden" />
        </rule>
        <rule name="MirrorGate front controller" stopProcessing="true">
          <match url="^index\.php$" ignoreCase="true" />
          <action type="None" />
        </rule>
        <rule name="MirrorGate well-known files" stopProcessing="true">
          <match url="^\.well-known/(?!.*\.(?:php[0-9]*|phtml|phar|phps|inc|pht)(?:/|$)).+$" ignoreCase="true" />
          <conditions>
            <add input="{REQUEST_FILENAME}" matchType="IsFile" />
          </conditions>
          <action type="None" />
        </rule>
        <rule name="MirrorGate catch-all" stopProcessing="true">
          <match url="^" />
          <action type="Rewrite" url="index.php" />
        </rule>
      </rules>
    </rewrite>
    <security>
      <requestFiltering>
        <!-- 10 MiB, keep equal to MAX_REQUEST_BODY_BYTES. -->
        <requestLimits maxAllowedContentLength="10485760" />
      </requestFiltering>
    </security>
  </system.webServer>
</configuration>
